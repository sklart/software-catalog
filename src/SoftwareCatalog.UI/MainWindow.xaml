<Window x:Class="SoftwareCatalog.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:SoftwareCatalog.UI.Converters" Title="Software Catalog" Width="1200" Height="720"><Window.Resources><converters:ScanRootAvailabilityConverter x:Key="Availability"/></Window.Resources><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="150"/><RowDefinition Height="2*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><GroupBox Header="Папки сканирования"><DockPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0"><CheckBox Content="Хранить путь относительно приложения" IsChecked="{Binding StoreRelativeToApplication}" VerticalAlignment="Center"/><Button Content="Добавить папку" Command="{Binding AddFolderCommand}"/><Button Content="Изменить" Command="{Binding ChangeFolderCommand}" Margin="8,0,0,0"/><Button Content="Удалить" Command="{Binding RemoveFolderCommand}" Margin="8,0,0,0"/><Button Content="Сканировать" Command="{Binding ScanCommand}" Margin="8,0,0,0"/><Button Content="Отмена" Command="{Binding CancelCommand}" Margin="8,0,0,0"/></StackPanel><ListBox ItemsSource="{Binding ScanRoots}" SelectedItem="{Binding SelectedScanRoot}"><ListBox.ItemTemplate><DataTemplate><DockPanel><TextBlock Text="{Binding ., Converter={StaticResource Availability}}" Foreground="Gray" DockPanel.Dock="Right"/><TextBlock Text="{Binding StoredPath}"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></GroupBox><GroupBox Grid.Row="1" Header="Продукты"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8"><Button Content="Проверить выбранный" Command="{Binding CheckSelectedCommand}"/><Button Content="Проверить все" Command="{Binding CheckAllCommand}" Margin="8,0,0,0"/></StackPanel><DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Продукт" Binding="{Binding CanonicalName}"/><DataGridTextColumn Header="Локальная версия" Binding="{Binding LatestLocalVersion, TargetNullValue=—}"/><DataGridTextColumn Header="Последняя версия" Binding="{Binding LatestVersion, TargetNullValue=—}"/><DataGridTextColumn Header="Издатель" Binding="{Binding Publisher, TargetNullValue=—}"/><DataGridTextColumn Header="Провайдер" Binding="{Binding UpdateProvider, TargetNullValue=—}"/><DataGridTextColumn Header="Статус" Binding="{Binding UpdateStatus}"/><DataGridTextColumn Header="Проверено" Binding="{Binding LastCheckedUtc, TargetNullValue=—}"/></DataGrid.Columns></DataGrid></DockPanel></GroupBox><GroupBox Grid.Row="2" Header="Файлы выбранного продукта"><DataGrid ItemsSource="{Binding ProductFiles}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Файл" Binding="{Binding FileName}"/><DataGridTextColumn Header="Версия" Binding="{Binding ProductVersion, TargetNullValue=—}"/><DataGridTextColumn Header="Архитектура" Binding="{Binding Architecture, TargetNullValue=—}"/><DataGridTextColumn Header="Тип" Binding="{Binding InstallerKind}"/><DataGridTextColumn Header="Путь" Binding="{Binding RelativePath}"/><DataGridCheckBoxColumn Header="Есть" Binding="{Binding Exists}"/></DataGrid.Columns></DataGrid></GroupBox><TextBlock Grid.Row="3" Text="{Binding StatusText}" Margin="0,8,0,0"/></Grid></Window>
