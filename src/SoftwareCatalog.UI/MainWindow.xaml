<Window x:Class="SoftwareCatalog.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:SoftwareCatalog.UI.Converters" Title="Software Catalog" Width="900" Height="600"><Window.Resources><converters:ScanRootAvailabilityConverter x:Key="Availability"/></Window.Resources><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="3*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><GroupBox Header="Scan folders"><DockPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0"><CheckBox Content="Store path relative to application" IsChecked="{Binding StoreRelativeToApplication}" VerticalAlignment="Center"/><Button Content="Add Folder" Command="{Binding AddFolderCommand}"/><Button Content="Change folder" Command="{Binding ChangeFolderCommand}" Margin="8,0,0,0"/><Button Content="Remove" Command="{Binding RemoveFolderCommand}" Margin="8,0,0,0"/><Button Content="Scan" Command="{Binding ScanCommand}" Margin="8,0,0,0"/><Button Content="Cancel" Command="{Binding CancelCommand}" Margin="8,0,0,0"/></StackPanel><ListBox ItemsSource="{Binding ScanRoots}" SelectedItem="{Binding SelectedScanRoot}"><ListBox.ItemTemplate><DataTemplate><DockPanel><TextBlock Text="{Binding ., Converter={StaticResource Availability}}" Foreground="Gray" DockPanel.Dock="Right"/><TextBlock Text="{Binding StoredPath}"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></GroupBox><GroupBox Grid.Row="1" Header="Files"><DataGrid ItemsSource="{Binding Files}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding FileName}"/><DataGridTextColumn Header="Path" Binding="{Binding RelativePath}"/><DataGridTextColumn Header="Size" Binding="{Binding Size}"/><DataGridTextColumn Header="Modified" Binding="{Binding LastWriteTimeUtc}"/><DataGridCheckBoxColumn Header="Exists" Binding="{Binding Exists}"/></DataGrid.Columns></DataGrid></GroupBox><TextBlock Grid.Row="2" Text="{Binding StatusText}" Margin="0,8,0,0"/></Grid></Window>
